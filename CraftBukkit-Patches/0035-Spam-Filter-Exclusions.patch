From ee0d00b7e6013265bb4b007bae76ca75f167f522 Mon Sep 17 00:00:00 2001
From: md_5 <git@md-5.net>
Date: Sat, 8 Feb 2014 08:13:40 +0000
Subject: [PATCH] Spam Filter Exclusions


diff --git a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
index a2517c8ff..3b47134ec 100644
--- a/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
+++ b/src/main/java/net/minecraft/server/network/ServerGamePacketListenerImpl.java
@@ -2150,7 +2150,7 @@ public class ServerGamePacketListenerImpl extends ServerCommonPacketListenerImpl
             }
             // CraftBukkit end
             this.performUnsignedChatCommand(packet.command());
-            this.detectCommandRateSpam();
+            this.detectCommandRateSpam("/" + packet.command()); // Spigot
         }, true); // CraftBukkit - sync commands
     }
 
@@ -2189,7 +2189,7 @@ public class ServerGamePacketListenerImpl extends ServerCommonPacketListenerImpl
                 }
                 // CraftBukkit end
                 this.performSignedChatCommand(packet, (LastSeenMessages) optional.get());
-                this.detectCommandRateSpam();
+                this.detectCommandRateSpam("/" + packet.command()); // Spigot
             }, true); // CraftBukkit - sync commands
         }
     }
@@ -2476,11 +2476,20 @@ public class ServerGamePacketListenerImpl extends ServerCommonPacketListenerImpl
         }
         // this.server.getPlayerList().broadcastChatMessage(message, this.player, ChatType.bind(ChatType.CHAT, (Entity) this.player));
         // CraftBukkit end
-        this.detectChatRateSpam();
+        this.detectChatRateSpam(s); // Spigot
     }
 
-    private void detectRateSpam(TickThrottler throttler) {
+    // Spigot start - spam exclusions
+    private void detectRateSpam(TickThrottler throttler, String s) {
         // CraftBukkit start - replaced with thread safe throttle
+        for ( String exclude : org.spigotmc.SpigotConfig.spamExclusions )
+        {
+            if ( exclude != null && s.startsWith( exclude ) )
+            {
+                return;
+            }
+        }
+        // Spigot end
         // throttler.increment();
         if (!throttler.isIncrementAndUnderThreshold() && !this.server.getPlayerList().isOp(this.player.nameAndId()) && !this.server.isSingleplayerOwner(this.player.nameAndId())) {
             // CraftBukkit end
@@ -2489,12 +2498,14 @@ public class ServerGamePacketListenerImpl extends ServerCommonPacketListenerImpl
 
     }
 
-    private void detectCommandRateSpam() {
-        this.detectRateSpam(this.commandSpamThrottler);
+    // Spigot start
+    private void detectCommandRateSpam(String s) {
+        this.detectRateSpam(this.commandSpamThrottler, s);
     }
 
-    private void detectChatRateSpam() {
-        this.detectRateSpam(this.chatSpamThrottler);
+    private void detectChatRateSpam(String s) {
+        this.detectRateSpam(this.chatSpamThrottler, s);
+        // Spigot end
     }
 
     @Override
diff --git a/src/main/java/org/spigotmc/SpigotConfig.java b/src/main/java/org/spigotmc/SpigotConfig.java
index 9744e9456..d53c089eb 100644
--- a/src/main/java/org/spigotmc/SpigotConfig.java
+++ b/src/main/java/org/spigotmc/SpigotConfig.java
@@ -6,6 +6,7 @@ import java.io.IOException;
 import java.lang.reflect.InvocationTargetException;
 import java.lang.reflect.Method;
 import java.lang.reflect.Modifier;
+import java.util.Arrays;
 import java.util.HashMap;
 import java.util.List;
 import java.util.Map;
@@ -284,4 +285,13 @@ public class SpigotConfig
     {
         playerShuffle = getInt( "settings.player-shuffle", 0 );
     }
+
+    public static List<String> spamExclusions;
+    private static void spamExclusions()
+    {
+        spamExclusions = getList( "commands.spam-exclusions", Arrays.asList( new String[]
+        {
+                "/skill"
+        } ) );
+    }
 }
